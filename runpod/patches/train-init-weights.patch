+def _load_init_weights(model, path):
+  """Load a safetensors file. Every tensor name and shape must match; the optimizer is left alone."""
+  from safetensors.torch import load_file
+  if not os.path.isfile(path):
+    raise SystemExit(f"--init-weights file not found: {path}")
+  incoming = load_file(path)
+  current = model.state_dict()
+  missing = sorted(k for k in current if k not in incoming)
+  extra = sorted(k for k in incoming if k not in current)
+  bad = sorted(k for k in current if k in incoming and tuple(incoming[k].shape) != tuple(current[k].shape))
+  if missing or extra or bad:
+    raise SystemExit(
+      "init-weights do not match this model. "
+      f"missing={missing[:12]} extra={extra[:12]} shape_mismatch={bad[:12]}"
+    )
+  model.load_state_dict({k: incoming[k].to(dtype=current[k].dtype) for k in current}, strict=True)
